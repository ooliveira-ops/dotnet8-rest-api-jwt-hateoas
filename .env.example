# Copie este arquivo para .env e preencha com seus valores reais.
# O .env NÃO é versionado (ver .gitignore). Nunca commite credenciais.

# ---------------------------------------------------------------
# Consumidas diretamente pelo docker-compose.yml
# ---------------------------------------------------------------

# Nome do banco criado/usado pela API no SQL Server
DB_NAME=nome-do-banco-aqui

# Senha do usuário 'sa' do SQL Server.
# Usada tanto em MSSQL_SA_PASSWORD (container do banco)
# quanto na connection string injetada na API.
# O SQL Server exige senha forte: 8+ caracteres, com maiúscula,
# minúscula, número e símbolo.
DB_PASSWORD=sua-senha-forte-aqui

# ---------------------------------------------------------------
# Usadas ao rodar fora do Docker / referência para o appsettings.json
# (não são lidas pelo docker-compose.yml atual)
# ---------------------------------------------------------------

# Host do SQL Server. Dentro do compose o host é o serviço 'sqlserver'.
# Rodando local sem Docker, use localhost,1433.
DB_HOST=localhost,1433

# Usuário do SQL Server
DB_USER=sa

# Chave usada para assinar os tokens JWT (TokenConfiguration:Secret).
# Gere um valor aleatório próprio, ex.: openssl rand -base64 32
JWT_SECRET=gere-uma-chave-aleatoria-aqui
